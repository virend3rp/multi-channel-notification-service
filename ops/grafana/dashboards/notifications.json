{
  "title": "Multi-Channel Notifications",
  "uid": "mcns",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Sent / failed / dead-lettered per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel, status) (rate(notifications_sent_total[1m]))",
          "legendFormat": "{{channel}} {{status}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Provider attempts by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel, outcome) (rate(notification_attempts_total[1m]))",
          "legendFormat": "{{channel}} {{outcome}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "p95 provider latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(provider_send_duration_seconds_bucket[1m])))",
          "legendFormat": "{{channel}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "p95 end-to-end latency (accepted \u2192 sent)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(notification_end_to_end_seconds_bucket[1m])))",
          "legendFormat": "{{channel}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Consumer lag",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (kafka_consumer_lag)",
          "legendFormat": "{{topic}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Retries by tier",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel, tier) (rate(notification_retries_total[1m]))",
          "legendFormat": "{{channel}} {{tier}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Circuit breaker state (0 closed, 1 half-open, 2 open)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "circuit_breaker_state",
          "legendFormat": "{{provider}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Outbox rows per relay poll / duplicates skipped",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "outbox_pending",
          "legendFormat": "outbox"
        },
        {
          "refId": "B",
          "expr": "sum by (channel) (rate(notification_duplicates_skipped_total[1m]))",
          "legendFormat": "dupes {{channel}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "API p95 latency by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "id": 9
    }
  ],
  "tags": [
    "notifications"
  ]
}